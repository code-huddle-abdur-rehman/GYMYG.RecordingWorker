# Recording Worker Environment
# Which perspective this worker instance records: client, trainer, coach, or all
JOIN_AS=client
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:3002/api
RECORDING_WORKER_API_KEY=change-me
WEB_APP_URL=http://localhost:5173
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
BUCKET_NAME=
CLASS_RECORDING_PREFIX=classRecordings
WORKOUT_PATH=/workout

# Dedicated client account used by the Playwright recording bot to pass app auth
EMAIL=botclient@example.com
PASSWORD=change-me

# Corporate admin account for trainer/coach mirror-view recording bots
CORPORATE_EMAIL=corporate-admin@example.com
CORPORATE_PASSWORD=change-me

# Delay audio during mux to compensate for Playwright screencast lag (milliseconds)
RECORDING_AUDIO_DELAY_MS=300

# Stop, upload and leave once no real user has been in the call for this long
# (milliseconds, default 10 min). 0 disables idle exit.
RECORDING_IDLE_TIMEOUT_MS=600000
# A bot page that has not reported its participant count for this long counts
# as "state unknown", never as idle (milliseconds).
RECORDING_IDLE_REPORT_STALE_MS=60000
